<!-- SDK: genera un proyecto web ASP.NET Core -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Framework objetivo: .NET 8.0 LTS -->
    <TargetFramework>net8.0</TargetFramework>
    <!-- Habilita análisis de nullables (warn sobre referencias potencialmente nulas) -->
    <Nullable>enable</Nullable>
    <!-- Habilita using implícitos (System, System.Linq, etc.) sin declararlos -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ID del Vault de secrets de desarrollador (dotnet user-secrets) -->
    <UserSecretsId>6e44694b-1b56-49e5-8ff5-b34f59a81705</UserSecretsId>
  </PropertyGroup>

  <!-- Dependencias NuGet del proyecto -->
  <ItemGroup>
    <!-- Autenticación JWT Bearer (validación de tokens en endpoints protegidos) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <!-- Driver PostgreSQL para Entity Framework Core (acceso a la base de datos) -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <!-- Swagger/OpenAPI: genera documentación de la API y UI de pruebas -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

</Project>
